# =============================================================
# Configuração dos pipelines de Speech Analytics — Aurélia
# Renomeie para .env e ajuste os valores conforme seu workspace.
# =============================================================

# --- Unity Catalog ---
# Catalog e schema onde tudo será criado (volume, tabelas, modelos).
CATALOG=field_toolbox_catalog
SCHEMA=aurelia_speech

# --- Volume de landing dos áudios ---
# Volume Unity Catalog onde os arquivos de áudio (.mp3 / .wav) chegam.
# Será criado pelo notebook 00_setup_env.py se não existir.
VOLUME_LANDING=audio_landing

# --- Endpoint do Whisper ---
# Endpoint de Model Serving que roda Whisper Large V3 Turbo (scale-to-zero).
# Schema: input = {"inputs":["<base64_audio>"]}, output = {"predictions":["<text>"]}
WHISPER_ENDPOINT=aurelia-whisper-turbo

# --- Endpoint do LLM para análise ---
# Foundation Model API. Sugestões boas para PT-BR:
#   - databricks-claude-sonnet-4-6  (mais capaz, recomendado)
#   - databricks-claude-haiku-4-5   (mais barato, rápido)
#   - databricks-meta-llama-3-3-70b-instruct (open weights)
LLM_ENDPOINT=databricks-claude-sonnet-4-6

# --- Tabelas (preenchidas automaticamente; só altere se quiser nomes custom) ---
TABLE_BRONZE=bronze_audio_files
TABLE_SILVER=silver_transcripts
TABLE_GOLD=gold_call_insights

# --- Versão com ai_transcribe (imperative/02b_silver_ai_transcribe.py) ---
# Silver e gold próprias, para as duas versões conviverem e serem comparadas.
TABLE_SILVER_AIT=silver_transcripts_ait
TABLE_GOLD_AIT=gold_call_insights_ait
